# DocuMind AI Pro Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Hosted mode uses an OpenAI-compatible Chat Completions API.
# Keep LLM_API_KEY in Streamlit secrets or a private environment variable; never commit it.
LLM_API_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=4
RRF_K=60
OLLAMA_TEMPERATURE=0.1
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_NUM_PREDICT=512
OLLAMA_PLANNER_TIMEOUT_SECONDS=25
OLLAMA_REPORT_TIMEOUT_SECONDS=90
OLLAMA_PLAN_NUM_PREDICT=256
OLLAMA_REPORT_NUM_PREDICT=2048
